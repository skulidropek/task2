{
  "name": "@effect-template/app",
  "version": "1.0.0",
  "description": "Streaming viewer for huge text files with memory-safe behavior",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build --ssr src/app/main.ts",
    "dev": "vite build --watch --ssr src/app/main.ts",
    "prestart": "pnpm run build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "^0.104.1",
    "effect": "^3.19.17",
    "iconv-lite": "^0.7.0",
    "jschardet": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
